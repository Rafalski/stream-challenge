    {
      "id": 15,
      "title": "Consumer lag (records)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Latest broker offset minus committed consumer offset, summed over partitions. Independent of Job ID selection. Flink commits on checkpoints; raw ingestion commits after each archive write. No data means unavailable or no committed offset, not zero. This is not window completeness or a recovery guarantee.",
      "gridPos": {
        "x": 6,
        "y": 21,
        "w": 18,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag{topic=\"pageviews\",consumergroup=~\"raw-archive|postcode-aggregation\"} and on (consumergroup, topic, partition) (kafka_consumergroup_current_offset{topic=\"pageviews\"} >= 0))",
          "legendFormat": "{{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job_name",
        "label": "Flink job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(flink_jobmanager_job_uptime, job_name)",
        "current": {
          "text": "postcode-pageviews",
          "value": "postcode-pageviews"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "job_id",
        "label": "Job ID (optional)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(flink_jobmanager_job_uptime{job_name=\"$job_name\"}, job_id)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "links": [
    {
      "title": "Flink UI",
      "url": "http://127.0.0.1:8081",
      "targetBlank": true
    },
    {
      "title": "Kafka browser (optional)",
      "url": "http://127.0.0.1:8080",
      "targetBlank": true
    },
    {
      "title": "Prometheus targets",
      "url": "http://127.0.0.1:9090/targets",
      "targetBlank": true
    }
  ],
  "description": "Live pipeline metrics for postcode-pageviews. Job ID optionally narrows Flink metrics to one submission. Cluster health and Kafka consumer lag use their own scope."
}
