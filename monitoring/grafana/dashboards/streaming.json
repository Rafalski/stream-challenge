      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(flink_taskmanager_job_task_operator_numRecordsIn{job_name=\"$job_name\",job_id=~\"$job_id\",operator_name=\"aggregate-files: Writer\"}[1m]))",
          "legendFormat": "Aggregate rows",
          "instant": false
