      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Scrape health is separate from consumer health. Missing lag is not treated as zero.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"kafka-exporter\"}",
          "instant": true
