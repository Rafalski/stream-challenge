      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flink_taskmanager_job_task_operator_valid_events{job_name=\"$job_name\",job_id=~\"$job_id\"}[$__rate_interval]))",
          "legendFormat": "Accepted",
          "instant": false
